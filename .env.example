# Local / compose-style environment for LABELOS API
LABELOS_API_TOKEN=change-me-to-a-long-random-secret
LABELOS_STORAGE_PATH=./storage
LABELOS_API_HOST=0.0.0.0
# Prefer platform PORT (Render and most PaaS) over LABELOS_API_PORT.
LABELOS_API_PORT=8080
LABELOS_LOG_LEVEL=INFO
LABELOS_API_BASE_URL=http://127.0.0.1:8080

# Illustrator bridge (workstation only)
LABELOS_BRIDGE_TOKEN=
LABELOS_BRIDGE_HOST=127.0.0.1
LABELOS_BRIDGE_PORT=8090
LABELOS_TEMPLATES_PATH=./templates
LABELOS_BRIDGE_OUTPUT_PATH=./storage/generated
